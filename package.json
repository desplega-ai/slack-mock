{
  "name": "@desplega.ai/slack-mock",
  "version": "0.1.0",
  "description": "Mock Slack server (Web API + Socket Mode) for end-to-end testing Slack bots",
  "type": "module",
  "license": "MIT",
  "bin": {
    "slack-mock": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "bun run src/cli.ts serve",
    "demo": "bun scripts/demo.ts",
    "build": "rm -rf dist && bun build src/index.ts src/cli.ts src/screenshot.ts --target=bun --outdir dist --splitting && tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:e2e": "SLACK_MOCK_E2E=1 bun test test/agent-swarm.e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "bun run typecheck && bun run lint && bun test && bun run build",
    "release": "npm publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@slack/bolt": "^4.6.0",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desplega-ai/slack-mock.git"
  },
  "homepage": "https://github.com/desplega-ai/slack-mock#readme",
  "keywords": [
    "slack",
    "mock",
    "socket-mode",
    "bolt",
    "testing",
    "e2e"
  ],
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
