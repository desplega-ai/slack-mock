{
  "name": "slack-mock",
  "version": "0.1.0",
  "description": "Mock Slack server (Web API + Socket Mode) for end-to-end testing Slack bots",
  "type": "module",
  "license": "MIT",
  "bin": {
    "slack-mock": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:e2e": "SLACK_MOCK_E2E=1 bun test test/agent-swarm.e2e.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@slack/bolt": "^4.6.0",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
